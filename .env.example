# =============================================================================
# Document Intelligence — Redaction Agent Environment
# =============================================================================
# Copy this file to `.env` (in this folder) and fill in your values.
# Authentication uses Azure AD via the signed-in `az` CLI identity. The
# identity needs the `Cognitive Services User` role (or higher) on every
# resource referenced below.
# =============================================================================

# -----------------------------------------------------------------------------
# Chat model (REQUIRED — choose Foundry OR Azure OpenAI)
# -----------------------------------------------------------------------------
# Option A: Microsoft Foundry project endpoint (preferred).
AI_FOUNDRY_PROJECT_ENDPOINT=<your-foundry-project-endpoint>
# Example: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# Option B: Dedicated Azure OpenAI resource (used if AZURE_OPENAI_ENDPOINT is set).
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o

# -----------------------------------------------------------------------------
# Azure AI Language — PII detection (REQUIRED)
# Used by the reviewer agent's `detect_pii_with_language_service` tool.
# -----------------------------------------------------------------------------
AZURE_LANGUAGE_ENDPOINT=https://<your-language-resource>.cognitiveservices.azure.com/

# -----------------------------------------------------------------------------
# Azure AI Document Intelligence (OPTIONAL)
# Only needed for scanned / image-only PDFs (OCR fallback). If unset, the
# pipeline reuses the host of AI_FOUNDRY_PROJECT_ENDPOINT.
# -----------------------------------------------------------------------------
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
